{
    "configurations": [
        {
            "name": "sgdk",
            "includePath": [
                "${workspaceFolder}\\..\\..\\SGDK\\inc",
                "${workspaceFolder}\\..\\..\\SGDK\\res",
                "${workspaceFolder}\\inc",
                "${workspaceFolder}\\res",
                "${workspaceFolder}\\src"
            ],
            "defines": [],
            "compilerPath": "${workspaceFolder}\\..\\..\\SGDK\\bin\\gcc.exe",
            "compilerArgs": [
                "-m68000",
                "-B${workspaceFolder}\\..\\..\\SGDK\\bin",
                "-Wall"
            ],
            "cStandard": "gnu11",
            "intelliSenseMode": "linux-gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}\\src",
                    "${workspaceFolder}\\inc",
                    "${workspaceFolder}\\..\\..\\SGDK\\inc"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}