{
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "editor.formatOnSave": true,
    "C_Cpp.intelliSenseEngine": "default",
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "search.exclude": {
        ".github": true,
        "**/*.o": true,
        "**/*.d": true,
        "**/*.exe": true,
        "**/*.dll": true,
        "**/*.jar": true,
        "**/*.bin": true,
        "**/*.out": true,
        "**/cmd_": true,
        "**/out.lst": true,
    },
    "[m68k]": {
        "editor.rulers": []
    },
}